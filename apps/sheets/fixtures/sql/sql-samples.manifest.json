      "queries": [
        {
          "name": "城市销售额",
          "sql": "SELECT c.[城市], ROUND(SUM(d.[行金额]),2) AS [销售额] FROM [客户] c JOIN [订单] o ON o.[客户ID]=c.[客户ID] JOIN [订单明细] d ON d.[订单ID]=o.[订单ID] WHERE o.[订单状态]<>'已取消' GROUP BY c.[城市] ORDER BY [销售额] DESC",
          "min_rows": 6
        },
        {
          "name": "月度销售趋势",
          "sql": "SELECT YEAR(o.[订单日期]) AS [年份], MONTH(o.[订单日期]) AS [月份], ROUND(SUM(d.[行金额]),2) AS [销售额] FROM [订单] o JOIN [订单明细] d ON d.[订单ID]=o.[订单ID] WHERE o.[订单状态]<>'已取消' GROUP BY YEAR(o.[订单日期]), MONTH(o.[订单日期]) ORDER BY [年份],[月份]",
          "min_rows": 10
        },
        {
          "name": "商品销量",
          "sql": "SELECT p.[类别], SUM(d.[数量]) AS [销量], ROUND(SUM(d.[行金额]),2) AS [销售额] FROM [商品] p JOIN [订单明细] d ON d.[商品ID]=p.[商品ID] GROUP BY p.[类别] ORDER BY [销售额] DESC",
          "min_rows": 5
        }
      ]
    },
